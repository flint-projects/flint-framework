name "engine-jdbc"
description "Flint's JDBC driver: flint.java.sql over the SQL engine, for jdbc:sqlite: and jdbc:postgresql: URLs"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:conc" version="*"
dependency "flint:engine-aot" version="*"
dependency "flint:engine-sql" version="*"
dependency "flint:java" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
