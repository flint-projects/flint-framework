name "web"
description "Flint web subpackage"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:reactor" version="*"
dependency "flint:conc" version="*"
dependency "flint:di" version="*"
dependency "flint:serde" version="*"
dependency "flint:validate" version="*"
dependency "flint:log" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
    excludedSourceFiles "tests/betterc.d"
}

// BEGIN FLINT NATIVE
versions "FlintNativeLlhttp" platform="linux-x86_64"
versions "FlintNativeNghttp2" platform="linux-x86_64"
versions "FlintNativeOpenssl" platform="linux-x86_64"
lflags "/home/olfa/flint-work/flint/.claude/worktrees/laughing-hugle-4ff9ba/.native/install/linux-x86_64-glibc/lib/libflint_ffi.a" platform="linux-x86_64"
lflags "/home/olfa/flint-work/flint/.claude/worktrees/laughing-hugle-4ff9ba/.native/install/linux-x86_64-glibc/lib/libssl.a" platform="linux-x86_64"
lflags "/home/olfa/flint-work/flint/.claude/worktrees/laughing-hugle-4ff9ba/.native/install/linux-x86_64-glibc/lib/libcrypto.a" platform="linux-x86_64"
lflags "/home/olfa/flint-work/flint/.claude/worktrees/laughing-hugle-4ff9ba/.native/install/linux-x86_64-glibc/lib/libnghttp2.a" platform="linux-x86_64"
lflags "/home/olfa/flint-work/flint/.claude/worktrees/laughing-hugle-4ff9ba/.native/install/linux-x86_64-glibc/lib/libllhttp.a" platform="linux-x86_64"
lflags "-lpthread" platform="linux-x86_64"
lflags "-ldl" platform="linux-x86_64"
lflags "-lm" platform="linux-x86_64"
// END FLINT NATIVE
