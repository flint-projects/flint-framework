module capturing_compute;

import flint.engine.ui_signals : SignalGraph, SignalId;

@safe:

/// A computed node stores a noncapturing function pointer, never a closure over caller state.
void attach(ref SignalGraph graph, SignalId input, int offset) nothrow
{
    SignalId[1] inputs = [input];
    cast(void) graph.computed(inputs[], (scope const(int)[] values) => values[0] + offset);
}
