name "probe-security-baseline"
targetType "executable"
sourcePaths "source" "../harness"
importPaths "source" "../harness"
targetPath "build"
targetName "probe-security-baseline"
dflags "-preview=dip1000"
dependency "flint:arena" path="../../../.."
dependency "flint:http" path="../../../.."
dependency "flint:serde" path="../../../.."
dependency "flint:conc" path="../../../.."
lflags "--wrap=malloc" "--wrap=calloc" "--wrap=realloc" platform="linux"
