(module
  (memory (export "memory") 1)
  (table 1 funcref)
  (global $counter (mut i32) (i32.const 0))
  (func (export "answer") (result i32) i32.const 42)
  (func (export "add") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add)
  (func (export "wrong-input") (param i64) (result i32) i32.const 0)
  (func (export "wrong-output") (result i64) i64.const 42)
  (func (export "trap") (result i32) unreachable)
  (func (export "grow") (param i32) (result i32) local.get 0 memory.grow)
  (func (export "table-grow") (param i32) (result i32) ref.null func local.get 0 table.grow 0)
  (func (export "bump") (result i32)
    global.get $counter i32.const 1 i32.add global.set $counter global.get $counter)
  (func (export "spin") (result i32) (loop br 0) unreachable))
