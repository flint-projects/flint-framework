(module
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $env_sizes (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_get" (func $env (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "poll_oneoff" (func $poll (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 128) "flint guest")
  (data (i32.const 160) "allowed")
  (data (i32.const 176) "../outside/secret")
  (data (i32.const 208) "escape")
  (data (i32.const 224) "newfile")

  (func (export "answer") (result i32) i32.const 42)

  (func (export "environment-count") (result i32)
    (drop (call $env_sizes (i32.const 16) (i32.const 20)))
    (i32.load (i32.const 16)))
  (func (export "environment-value") (result i32)
    (drop (call $env_sizes (i32.const 16) (i32.const 20)))
    (if (i32.eqz (i32.load (i32.const 16))) (then (return (i32.const 0))))
    (drop (call $env (i32.const 32) (i32.const 352)))
    ;; For the fixture's single NOTE=red entry, the first value byte is 'r'.
    (i32.load8_u (i32.const 357)))

  (func (export "emit") (param $fd i32) (result i32)
    (i32.store (i32.const 0) (i32.const 128))
    (i32.store (i32.const 4) (i32.const 11))
    (call $write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 24)))

  (func $file (param $name i32) (param $len i32) (result i32)
    (local $code i32) (local $fd i32)
    (local.set $code
      (call $open (i32.const 3) (i32.const 1) (local.get $name) (local.get $len) (i32.const 0)
        (i64.const 2) (i64.const 0) (i32.const 0) (i32.const 48)))
    (if (local.get $code) (then (return (local.get $code))))
    (local.set $fd (i32.load (i32.const 48)))
    (i32.store (i32.const 0) (i32.const 400))
    (i32.store (i32.const 4) (i32.const 1))
    (local.set $code (call $read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 24)))
    (drop (call $close (local.get $fd)))
    (if (local.get $code) (then (return (local.get $code))))
    (i32.load8_u (i32.const 400)))

  (func (export "read-allowed") (result i32) (call $file (i32.const 160) (i32.const 7)))
  (func (export "read-parent") (result i32) (call $file (i32.const 176) (i32.const 17)))
  (func (export "read-link") (result i32) (call $file (i32.const 208) (i32.const 6)))
  (func (export "create-file") (result i32)
    (local $status i32)
    (local.set $status
      (call $open (i32.const 3) (i32.const 0) (i32.const 224) (i32.const 7) (i32.const 1)
        (i64.const 64) (i64.const 0) (i32.const 0) (i32.const 48)))
    (if (i32.eqz (local.get $status))
      (then (drop (call $close (i32.load (i32.const 48))))))
    (local.get $status))

  (func (export "sleep") (result i32)
    (i32.store (i32.const 512) (i32.const 0))
    (i32.store8 (i32.const 520) (i32.const 0))
    (i32.store (i32.const 528) (i32.const 1))
    (i64.store (i32.const 536) (i64.const 5000000000))
    (i64.store (i32.const 544) (i64.const 1000000))
    (i32.store16 (i32.const 552) (i32.const 0))
    (call $poll (i32.const 512) (i32.const 576) (i32.const 1) (i32.const 640))))
