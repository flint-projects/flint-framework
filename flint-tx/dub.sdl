name "tx"
description "spring-tx: flint.dao (the data access exception hierarchy) and flint.transaction (ADR-030)"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:core" version="*"
dependency "flint:engine-aot" version="*"
dependency "flint:java" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
