name "flint-graceful-shutdown-fixture"
description "SIGTERM and SIGINT drive flint:engine-web's graceful shutdown through flint:os (ADR-028 section 10)"
targetType "executable"
sourcePaths "source"
targetPath "build"
dflags "-preview=dip1000"
dependency "flint:arena" path="../../../.."
dependency "flint:conc" path="../../../.."
dependency "flint:engine-reactor" path="../../../.."
dependency "flint:os" path="../../../.."
dependency "flint:engine-web" path="../../../.."
