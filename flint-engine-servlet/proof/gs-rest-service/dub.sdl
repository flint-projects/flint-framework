name "gs-rest-service-proof"
description "gs-rest-service's GreetingController served over real HTTP: flint:webmvc's DispatcherServlet on flint.engine.servlet"
license "Apache-2.0"
targetType "executable"
sourcePaths "source"
importPaths "source" "../../../framework-test/tests"
sourceFiles "../../../framework-test/tests/com/example/restservice/package.d"
dflags "-preview=dip1000"
dependency "engine-servlet" path="../.."
dependency "webmvc" path="../../../webmvc"
dependency "web" path="../../../web"
dependency "jakarta-servlet" path="../../../jakarta-servlet"
dependency "p1-interim" path="../../../p1-interim"
dependency "engine-aot" path="../../../engine-aot"
