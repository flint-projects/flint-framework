name "engine-servlet"
description "flint.engine.servlet: Flint's servlet container over flint:engine-web fiber routes, the counterpart of embedded Tomcat for Spring Web MVC"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:arena" version="*"
dependency "flint:conc" version="*"
dependency "flint:engine-aot" version="*"
dependency "flint:engine-web" version="*"
dependency "flint:jakarta-servlet" version="*"
dependency "flint:java" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
