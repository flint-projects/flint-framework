name "framework-web"
description "Flint Web: the port of spring-web (interim name; becomes flint:web after the engine rename)"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "framework-interim" path="../framework-interim"
dependency "jakarta-servlet" path="../jakarta-servlet"
dependency "engine-aot" path="../engine-aot"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
