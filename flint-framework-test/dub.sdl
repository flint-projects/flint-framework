name "framework-test"
description "Flint Test (MockMvc part): the port of spring-test's org.springframework.test.web.servlet and org.springframework.mock.web (interim name; see docs/spring/phase1/web-mvc.md, open question 1)"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:context" version="*"
dependency "flint:core" version="*"
dependency "flint:engine-aot" version="*"
dependency "flint:jackson-databind" version="*"
dependency "flint:jakarta-servlet" version="*"
dependency "flint:java" version="*"
dependency "flint:web" version="*"
dependency "flint:webmvc" version="*"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
