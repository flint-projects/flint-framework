// flint-projects/flint-framework: the framework repo of Flint. Its packages keep the flint:* names; build them in a
// workspace with the repos they depend on (python3 tools/workspace.py dub-root, in the flint repo).
name "flint"
description "Flint framework (framework repo)"
license "Apache-2.0"
targetType "none"
subPackage "flint-beans"
subPackage "flint-context"
subPackage "flint-core"
subPackage "engine/actuator"
subPackage "flint-engine-aot"
subPackage "engine/cache"
subPackage "engine/codec"
subPackage "engine/desktop"
subPackage "engine/di"
subPackage "engine/http"
subPackage "flint-engine-jdbc"
subPackage "engine/mail"
subPackage "engine/migrate"
subPackage "engine/mq"
subPackage "engine/prompt"
subPackage "engine/reactor"
subPackage "engine/rpc"
subPackage "engine/schedule"
subPackage "engine/security"
subPackage "flint-engine-servlet"
subPackage "engine/sql"
subPackage "engine/storage"
subPackage "engine/style"
subPackage "engine/template"
subPackage "engine/tui"
subPackage "engine/ui-signals"
subPackage "engine/wasi"
subPackage "engine/wasm-bridge"
subPackage "engine/web"
subPackage "engine/widgets"
subPackage "flint-framework-test"
subPackage "flint-hibernate-validator"
subPackage "flint-jackson-annotations"
subPackage "flint-jackson-core"
subPackage "flint-jackson-databind"
subPackage "flint-jakarta-annotation"
subPackage "flint-jakarta-servlet"
subPackage "flint-jakarta-validation"
subPackage "flint-java"
subPackage "flint-jdbc"
subPackage "flint-slf4j-api"
subPackage "flint-tx"
subPackage "flint-web"
subPackage "flint-webmvc"
