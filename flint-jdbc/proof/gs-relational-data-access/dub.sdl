name "gs-relational-data-access-proof"
description "gs-relational-data-access's CommandLineRunner on flint:jdbc's JdbcTemplate, the Flint JDBC driver and Boot's console logging"
license "Apache-2.0"
targetType "executable"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "flint:jdbc" path="../../../.."
dependency "flint:engine-jdbc" path="../../../.."
dependency "flint:java" path="../../../.."
dependency "flint:slf4j-api" path="../../../.."
dependency "boot-core" path="../../../../boot/core/flint-boot"
dependency "flint:tx" path="../../../.."
dependency "flint:engine-aot" path="../../../.."
