/// The JSON backend of the streaming layer: factory, features, generator and parser.
module flint.jackson.core.json;

import flint.jackson.core : JacksonException, JsonGenerator, JsonParser, JsonToken,
    ObjectReadContext, ObjectWriteContext, PrettyPrinter,
    StreamReadConstraints, StreamReadFeature,
    StreamWriteFeature, TokenStreamContext, TokenStreamLocation, enabledByDefault, tokenName;
import flint.jackson.core.exc : InputCoercionException, StreamConstraintsException,
    StreamReadException, StreamWriteException, UnexpectedEndOfInputException;
import flint.jackson.core.io : NumberOutput, lowerHexDigits, outputEscape, upperHexDigits;
import flint.jackson.core.util : ByteArrayBuilder;
import flint.serde.java_number : formatJavaDouble, formatJavaFloat, javaNumberCapacity;
import flint.serde.json_read : JsonDecodeOptions, JsonNumberToken, JsonScanner, JsonTextToken,
    copyJsonText, parseJsonDecimal;

@safe:

/// Receives generated bytes; stands in for `java.io.OutputStream.write(byte[], int, int)` (rulebook R9).
alias OutputSink = void delegate(scope const(ubyte)[] bytes) @safe;

private string decimal(long value) pure nothrow
{
    char[20] digits;
    return digits[0 .. NumberOutput.writeLong(value, digits)].idup;
}

/// Token reader (parser) features specific to JSON backend.
enum JsonReadFeature
{
    /// Allow Java/C++ style comments. Default: false.
    ALLOW_JAVA_COMMENTS,
    /// Allow YAML comments starting with '#'. Default: false.
    ALLOW_YAML_COMMENTS,
    /// Allow a backslash before any character. Default: false.
    ALLOW_BACKSLASH_ESCAPING_ANY_CHARACTER,
    /// Allow single-quoted strings. Default: false.
    ALLOW_SINGLE_QUOTES,
    /// Allow the RS control character. Default: false.
    ALLOW_RS_CONTROL_CHAR,
    /// Allow unescaped control characters within strings. Default: false.
    ALLOW_UNESCAPED_CONTROL_CHARS,
    /// Allow unquoted property names. Default: false.
    ALLOW_UNQUOTED_PROPERTY_NAMES,
    /// Allow a leading decimal point (".5"). Default: false.
    ALLOW_LEADING_DECIMAL_POINT_FOR_NUMBERS,
    /// Allow a leading plus sign. Default: false.
    ALLOW_LEADING_PLUS_SIGN_FOR_NUMBERS,
    /// Allow leading zeros ("007"). Default: false.
    ALLOW_LEADING_ZEROS_FOR_NUMBERS,
    /// Allow NaN and Infinity tokens. Default: false.
    ALLOW_NON_NUMERIC_NUMBERS,
    /// Allow a trailing decimal point ("1."). Default: false.
    ALLOW_TRAILING_DECIMAL_POINT_FOR_NUMBERS,
    /// Allow missing values in arrays ("[1,,2]"). Default: false.
    ALLOW_MISSING_VALUES,
    /// Allow a trailing comma before a closing marker. Default: false.
    ALLOW_TRAILING_COMMA,
}

/// Token writer features specific to JSON backend.
enum JsonWriteFeature
{
    /// Whether property names are quoted. Default: true.
    QUOTE_PROPERTY_NAMES,
    /// Whether NaN and infinities are written as quoted strings. Default: true.
    WRITE_NAN_AS_STRINGS,
    /// Whether '/' is escaped. Default: false.
    ESCAPE_FORWARD_SLASHES,
    /// Whether all non-ASCII characters are escaped as \uXXXX. Default: false.
    ESCAPE_NON_ASCII,
    /// Whether \uXXXX escapes use uppercase hexadecimal. Default: true.
    WRITE_HEX_UPPER_CASE,
    /// Whether numbers are written as quoted strings. Default: false.
    WRITE_NUMBERS_AS_STRINGS,
}

/// Whether the JSON read feature is enabled by default (Jackson 3.1.8: none are).
bool enabledByDefault(JsonReadFeature) pure nothrow @nogc
{
    return false;
}

/// Whether the JSON write feature is enabled by default (Jackson 3.1.8).
bool enabledByDefault(JsonWriteFeature f) pure nothrow @nogc
{
    return f == JsonWriteFeature.QUOTE_PROPERTY_NAMES || f == JsonWriteFeature.WRITE_NAN_AS_STRINGS
        || f == JsonWriteFeature.WRITE_HEX_UPPER_CASE;
}

private uint defaults(E)() pure nothrow @nogc
{
    uint mask;
    foreach (f; __traits(allMembers, E))
        if (enabledByDefault(__traits(getMember, E, f)))
            mask |= 1u << __traits(getMember, E, f);
    return mask;
}

/**
 * JSON-backed `TokenStreamFactory` implementation that will create token
 * readers ("parsers") and writers ("generators") for handling JSON-encoded
 * content. Instances are immutable: use `JsonFactory.builder()` or `rebuild()`
 * to configure.
 */
final class JsonFactory
{
    /// Name used to identify JSON format.
    enum string FORMAT_NAME_JSON = "JSON";

    private uint _streamReadFeatures;
    private uint _streamWriteFeatures;
    private uint _formatReadFeatures;
    private uint _formatWriteFeatures;
    private StreamReadConstraints _streamReadConstraints;
    private string _rootValueSeparator = " ";

    /// Default constructor used to create factory instances.
    this() pure nothrow @nogc
    {
        _streamReadFeatures = defaults!StreamReadFeature();
        _streamWriteFeatures = defaults!StreamWriteFeature();
        _formatReadFeatures = defaults!JsonReadFeature();
        _formatWriteFeatures = defaults!JsonWriteFeature();
    }

    /// Constructor used by `JsonFactoryBuilder` for instantiation.
    this(JsonFactoryBuilder b) pure nothrow @nogc
    {
        _streamReadFeatures = b._streamReadFeatures;
        _streamWriteFeatures = b._streamWriteFeatures;
        _formatReadFeatures = b._formatReadFeatures;
        _formatWriteFeatures = b._formatWriteFeatures;
        _streamReadConstraints = b._streamReadConstraints;
        _rootValueSeparator = b._rootValueSeparator;
    }

    /// Main factory method to use for constructing `JsonFactory` instances with different configuration.
    static JsonFactoryBuilder builder() pure nothrow
    {
        return new JsonFactoryBuilder();
    }

    /// A builder initialized with this factory's configuration.
    JsonFactoryBuilder rebuild() pure nothrow
    {
        return new JsonFactoryBuilder(this);
    }

    /// Format name: "JSON".
    string getFormatName() const pure nothrow @nogc
    {
        return FORMAT_NAME_JSON;
    }

    ///
    bool isEnabled(StreamReadFeature f) const pure nothrow @nogc
    {
        return (_streamReadFeatures & (1u << f)) != 0;
    }

    ///
    bool isEnabled(StreamWriteFeature f) const pure nothrow @nogc
    {
        return (_streamWriteFeatures & (1u << f)) != 0;
    }

    ///
    bool isEnabled(JsonReadFeature f) const pure nothrow @nogc
    {
        return (_formatReadFeatures & (1u << f)) != 0;
    }

    ///
    bool isEnabled(JsonWriteFeature f) const pure nothrow @nogc
    {
        return (_formatWriteFeatures & (1u << f)) != 0;
    }

    /// The stream read constraints new parsers receive.
    StreamReadConstraints streamReadConstraints() const pure nothrow @nogc
    {
        return _streamReadConstraints;
    }

    /// The separator written between root-level values.
    string getRootValueSeparator() const pure nothrow @nogc
    {
        return _rootValueSeparator;
    }

    /// Create a generator that writes UTF-8 to `sink`, configured by `writeCtxt`.
    JsonGenerator createGenerator(ObjectWriteContext writeCtxt, OutputSink sink)
    {
        return new UTF8JsonGenerator(writeCtxt is null ? ObjectWriteContext.empty() : writeCtxt, this, sink);
    }

    /// Create a generator that appends UTF-8 to `target`.
    JsonGenerator createGenerator(ObjectWriteContext writeCtxt, ByteArrayBuilder target)
    {
        return createGenerator(writeCtxt, (scope const(ubyte)[] bytes) { target.write(bytes); });
    }

    /// Create a generator with the empty write context.
    JsonGenerator createGenerator(OutputSink sink)
    {
        return createGenerator(ObjectWriteContext.empty(), sink);
    }

    /// Create a parser over a complete UTF-8 document; the parser borrows `content` until it is closed.
    JsonParser createParser(ObjectReadContext readCtxt, const(ubyte)[] content)
    {
        return new UTF8StreamJsonParser(readCtxt is null ? ObjectReadContext.empty() : readCtxt, this, content);
    }

    /// Create a parser over a JSON string.
    JsonParser createParser(ObjectReadContext readCtxt, string content)
    {
        return createParser(readCtxt, cast(const(ubyte)[]) content);
    }

    /// Create a parser with the empty read context.
    JsonParser createParser(string content)
    {
        return createParser(ObjectReadContext.empty(), content);
    }

    /// ditto
    JsonParser createParser(const(ubyte)[] content)
    {
        return createParser(ObjectReadContext.empty(), content);
    }
}

/// `TSFBuilder` implementation for constructing vanilla `JsonFactory` instances for reading/writing JSON encoded content.
final class JsonFactoryBuilder
{
    private uint _streamReadFeatures;
    private uint _streamWriteFeatures;
    private uint _formatReadFeatures;
    private uint _formatWriteFeatures;
    private StreamReadConstraints _streamReadConstraints;
    private string _rootValueSeparator = " ";

    ///
    this() pure nothrow @nogc
    {
        _streamReadFeatures = defaults!StreamReadFeature();
        _streamWriteFeatures = defaults!StreamWriteFeature();
        _formatReadFeatures = defaults!JsonReadFeature();
        _formatWriteFeatures = defaults!JsonWriteFeature();
    }

    /// A builder initialized from `base`.
    this(JsonFactory base) pure nothrow @nogc
    {
        _streamReadFeatures = base._streamReadFeatures;
        _streamWriteFeatures = base._streamWriteFeatures;
        _formatReadFeatures = base._formatReadFeatures;
        _formatWriteFeatures = base._formatWriteFeatures;
        _streamReadConstraints = base._streamReadConstraints;
        _rootValueSeparator = base._rootValueSeparator;
    }

    private static void set(ref uint mask, uint bit, bool state) pure nothrow @nogc
    {
        if (state)
            mask |= 1u << bit;
        else
            mask &= ~(1u << bit);
    }

    ///
    JsonFactoryBuilder enable(StreamReadFeature f) pure nothrow @nogc
    {
        return configure(f, true);
    }

    ///
    JsonFactoryBuilder disable(StreamReadFeature f) pure nothrow @nogc
    {
        return configure(f, false);
    }

    ///
    JsonFactoryBuilder configure(StreamReadFeature f, bool state) pure nothrow @nogc
    {
        set(_streamReadFeatures, f, state);
        return this;
    }

    ///
    JsonFactoryBuilder enable(StreamWriteFeature f) pure nothrow @nogc
    {
        return configure(f, true);
    }

    ///
    JsonFactoryBuilder disable(StreamWriteFeature f) pure nothrow @nogc
    {
        return configure(f, false);
    }

    ///
    JsonFactoryBuilder configure(StreamWriteFeature f, bool state) pure nothrow @nogc
    {
        set(_streamWriteFeatures, f, state);
        return this;
    }

    ///
    JsonFactoryBuilder enable(JsonReadFeature f) pure nothrow @nogc
    {
        return configure(f, true);
    }

    ///
    JsonFactoryBuilder disable(JsonReadFeature f) pure nothrow @nogc
    {
        return configure(f, false);
    }

    ///
    JsonFactoryBuilder configure(JsonReadFeature f, bool state) pure nothrow @nogc
    {
        set(_formatReadFeatures, f, state);
        return this;
    }

    ///
    JsonFactoryBuilder enable(JsonWriteFeature f) pure nothrow @nogc
    {
        return configure(f, true);
    }

    ///
    JsonFactoryBuilder disable(JsonWriteFeature f) pure nothrow @nogc
    {
        return configure(f, false);
    }

    ///
    JsonFactoryBuilder configure(JsonWriteFeature f, bool state) pure nothrow @nogc
    {
        set(_formatWriteFeatures, f, state);
        return this;
    }

    /// Replace the stream read constraints.
    JsonFactoryBuilder streamReadConstraints(StreamReadConstraints src) pure nothrow @nogc
    {
        _streamReadConstraints = src;
        return this;
    }

    /// Replace the separator written between root-level values (null for none).
    JsonFactoryBuilder rootValueSeparator(string sep) pure nothrow @nogc
    {
        _rootValueSeparator = sep;
        return this;
    }

    /// Create the factory.
    JsonFactory build() pure nothrow
    {
        return new JsonFactory(this);
    }
}

/// Extension of `TokenStreamContext`, which implements core methods needed, and also exposes more complete API to generator implementation classes.
final class JsonWriteContext : TokenStreamContext
{
    /// Value write status: write as is.
    enum int STATUS_OK_AS_IS = 0;
    /// Value write status: write after a comma.
    enum int STATUS_OK_AFTER_COMMA = 1;
    /// Value write status: write after a colon.
    enum int STATUS_OK_AFTER_COLON = 2;
    /// Value write status: write after a root separator.
    enum int STATUS_OK_AFTER_SPACE = 3;
    /// Value write status: a value was expected.
    enum int STATUS_EXPECT_VALUE = 4;
    /// Value write status: a property name was expected.
    enum int STATUS_EXPECT_NAME = 5;

    private JsonWriteContext _child;
    private bool _gotName;

    private this(int type, JsonWriteContext parent) pure nothrow @nogc
    {
        _type = type;
        _parent = parent;
        _index = -1;
    }

    /// The root context of a new generator.
    static JsonWriteContext createRootContext() pure nothrow
    {
        return new JsonWriteContext(TYPE_ROOT, null);
    }

    /// Enter an Array, reusing the child context object.
    JsonWriteContext createChildArrayContext(Object currentValue) pure nothrow
    {
        return child(TYPE_ARRAY, currentValue);
    }

    /// Enter an Object, reusing the child context object.
    JsonWriteContext createChildObjectContext(Object currentValue) pure nothrow
    {
        return child(TYPE_OBJECT, currentValue);
    }

    private JsonWriteContext child(int type, Object currentValue) pure nothrow
    {
        if (_child is null)
            _child = new JsonWriteContext(type, this);
        else
        {
            _child._type = type;
            _child._index = -1;
            _child._currentName = null;
            _child._gotName = false;
        }
        _child._currentValue = currentValue;
        return _child;
    }

    /// The parent context.
    override JsonWriteContext getParent() pure nothrow @nogc
    {
        return cast(JsonWriteContext) _parent;
    }

    /// Record a property name; returns `STATUS_EXPECT_VALUE` when a value was due.
    int writeName(string name) pure nothrow @nogc
    {
        if (_type != TYPE_OBJECT || _gotName)
            return STATUS_EXPECT_VALUE;
        _gotName = true;
        _currentName = name;
        return _index < 0 ? STATUS_OK_AS_IS : STATUS_OK_AFTER_COMMA;
    }

    /// Record a value; returns the separator status, or `STATUS_EXPECT_NAME` when a name was due.
    int writeValue() pure nothrow @nogc
    {
        if (_type == TYPE_OBJECT)
        {
            if (!_gotName)
                return STATUS_EXPECT_NAME;
            _gotName = false;
            ++_index;
            return STATUS_OK_AFTER_COLON;
        }
        if (_type == TYPE_ARRAY)
        {
            immutable ix = _index;
            ++_index;
            return ix < 0 ? STATUS_OK_AS_IS : STATUS_OK_AFTER_COMMA;
        }
        ++_index;
        return _index == 0 ? STATUS_OK_AS_IS : STATUS_OK_AFTER_SPACE;
    }
}

/**
 * Generator that outputs JSON content using a byte buffer, encoding Strings as
 * UTF-8 and writing everything else as ASCII.
 */
class UTF8JsonGenerator : JsonGenerator
{
    alias writeNumber = JsonGenerator.writeNumber;
    alias writeString = JsonGenerator.writeString;
    alias writeStartObject = JsonGenerator.writeStartObject;
    alias writeStartArray = JsonGenerator.writeStartArray;

    private enum size_t BYTE_BUFFER_SIZE = 8000;

    private ObjectWriteContext _objectWriteContext;
    private JsonFactory _factory;
    private OutputSink _sink;
    private PrettyPrinter _cfgPrettyPrinter;
    private JsonWriteContext _streamWriteContext;
    private ubyte[] _outputBuffer;
    private size_t _outputTail;
    private bool _closed;
    private bool _quoteNames;
    private bool _nanAsStrings;
    private bool _escapeSlash;
    private bool _escapeNonAscii;
    private bool _numbersAsStrings;
    private string _hex;
    private string _rootValueSeparator;

    /// A generator over `sink`, configured by the factory and the write context.
    this(ObjectWriteContext writeCtxt, JsonFactory factory, OutputSink sink)
    {
        _objectWriteContext = writeCtxt;
        _factory = factory;
        _sink = sink;
        _cfgPrettyPrinter = writeCtxt.getPrettyPrinter();
        _streamWriteContext = JsonWriteContext.createRootContext();
        _outputBuffer = new ubyte[BYTE_BUFFER_SIZE];
        _quoteNames = factory.isEnabled(JsonWriteFeature.QUOTE_PROPERTY_NAMES);
        _nanAsStrings = factory.isEnabled(JsonWriteFeature.WRITE_NAN_AS_STRINGS);
        _escapeSlash = factory.isEnabled(JsonWriteFeature.ESCAPE_FORWARD_SLASHES);
        _escapeNonAscii = factory.isEnabled(JsonWriteFeature.ESCAPE_NON_ASCII);
        _numbersAsStrings = factory.isEnabled(JsonWriteFeature.WRITE_NUMBERS_AS_STRINGS);
        _hex = factory.isEnabled(JsonWriteFeature.WRITE_HEX_UPPER_CASE) ? upperHexDigits : lowerHexDigits;
        _rootValueSeparator = factory.getRootValueSeparator();
    }

    override TokenStreamContext streamWriteContext()
    {
        return _streamWriteContext;
    }

    override PrettyPrinter getPrettyPrinter()
    {
        return _cfgPrettyPrinter;
    }

    override bool isEnabled(StreamWriteFeature f)
    {
        return _factory.isEnabled(f);
    }

    override ObjectWriteContext objectWriteContext()
    {
        return _objectWriteContext;
    }

    private void put(ubyte b)
    {
        if (_outputTail == _outputBuffer.length)
            flushBuffer();
        _outputBuffer[_outputTail++] = b;
    }

    private void put(scope const(char)[] text)
    {
        put(cast(const(ubyte)[]) text);
    }

    private void put(scope const(ubyte)[] bytes)
    {
        if (bytes.length > _outputBuffer.length - _outputTail)
        {
            flushBuffer();
            if (bytes.length > _outputBuffer.length)
            {
                _sink(bytes);
                return;
            }
        }
        _outputBuffer[_outputTail .. _outputTail + bytes.length] = bytes;
        _outputTail += bytes.length;
    }

    private void flushBuffer()
    {
        if (_outputTail > 0)
        {
            immutable length = _outputTail;
            _outputTail = 0;
            _sink(_outputBuffer[0 .. length]);
        }
    }

    private void verifyValueWrite(string typeMsg)
    {
        immutable status = _streamWriteContext.writeValue();
        if (status == JsonWriteContext.STATUS_EXPECT_NAME)
            throw new StreamWriteException(this,
                    "Can not " ~ typeMsg ~ ", expecting a property name (context: " ~ _streamWriteContext.typeDesc()
                    ~ ")");
        if (_cfgPrettyPrinter !is null)
        {
            verifyPrettyValueWrite(status);
            return;
        }
        switch (status)
        {
        case JsonWriteContext.STATUS_OK_AFTER_COMMA:
            put(',');
            break;
        case JsonWriteContext.STATUS_OK_AFTER_COLON:
            put(':');
            break;
        case JsonWriteContext.STATUS_OK_AFTER_SPACE:
            if (_rootValueSeparator !is null)
                put(_rootValueSeparator);
            break;
        default:
            break;
        }
    }

    private void verifyPrettyValueWrite(int status)
    {
        switch (status)
        {
        case JsonWriteContext.STATUS_OK_AFTER_COMMA:
            _cfgPrettyPrinter.writeArrayValueSeparator(this);
            break;
        case JsonWriteContext.STATUS_OK_AFTER_COLON:
            _cfgPrettyPrinter.writeObjectNameValueSeparator(this);
            break;
        case JsonWriteContext.STATUS_OK_AFTER_SPACE:
            _cfgPrettyPrinter.writeRootValueSeparator(this);
            break;
        default:
            if (_streamWriteContext.inArray())
                _cfgPrettyPrinter.beforeArrayValues(this);
            else if (_streamWriteContext.inObject())
                _cfgPrettyPrinter.beforeObjectEntries(this);
            break;
        }
    }

    override JsonGenerator writeStartObject()
    {
        verifyValueWrite("start an object");
        _streamWriteContext = _streamWriteContext.createChildObjectContext(null);
        if (_cfgPrettyPrinter !is null)
            _cfgPrettyPrinter.writeStartObject(this);
        else
            put('{');
        return this;
    }

    override JsonGenerator writeEndObject()
    {
        if (!_streamWriteContext.inObject())
            throw new StreamWriteException(this, "Current context not an Object but " ~ _streamWriteContext.typeDesc());
        if (_cfgPrettyPrinter !is null)
            _cfgPrettyPrinter.writeEndObject(this, _streamWriteContext.getEntryCount());
        else
            put('}');
        _streamWriteContext = _streamWriteContext.getParent();
        return this;
    }

    override JsonGenerator writeStartArray()
    {
        verifyValueWrite("start an array");
        _streamWriteContext = _streamWriteContext.createChildArrayContext(null);
        if (_cfgPrettyPrinter !is null)
            _cfgPrettyPrinter.writeStartArray(this);
        else
            put('[');
        return this;
    }

    override JsonGenerator writeEndArray()
    {
        if (!_streamWriteContext.inArray())
            throw new StreamWriteException(this, "Current context not an Array but " ~ _streamWriteContext.typeDesc());
        if (_cfgPrettyPrinter !is null)
            _cfgPrettyPrinter.writeEndArray(this, _streamWriteContext.getEntryCount());
        else
            put(']');
        _streamWriteContext = _streamWriteContext.getParent();
        return this;
    }

    override JsonGenerator writeName(string name)
    {
        immutable status = _streamWriteContext.writeName(name);
        if (status == JsonWriteContext.STATUS_EXPECT_VALUE)
            throw new StreamWriteException(this, "Can not write a property name, expecting a value");
        if (_cfgPrettyPrinter !is null)
        {
            if (status == JsonWriteContext.STATUS_OK_AFTER_COMMA)
                _cfgPrettyPrinter.writeObjectEntrySeparator(this);
            else
                _cfgPrettyPrinter.beforeObjectEntries(this);
        }
        else if (status == JsonWriteContext.STATUS_OK_AFTER_COMMA)
            put(',');
        if (_quoteNames)
            quoted(name);
        else
            escaped(name);
        return this;
    }

    override JsonGenerator writeString(string value)
    {
        verifyValueWrite("write a string");
        if (value is null)
        {
            put("null");
            return this;
        }
        quoted(value);
        return this;
    }

    private void quoted(scope const(char)[] text)
    {
        put('"');
        escaped(text);
        put('"');
    }

    private void escaped(scope const(char)[] text)
    {
        auto bytes = cast(const(ubyte)[]) text;
        size_t run;
        size_t i;
        while (i < bytes.length)
        {
            immutable b = bytes[i];
            int esc;
            if (b < 0x80)
                esc = outputEscape(b, _escapeSlash);
            else if (_escapeNonAscii)
                esc = -2;
            if (esc == 0)
            {
                ++i;
                continue;
            }
            put(bytes[run .. i]);
            if (esc == -2)
                i = escapeNonAscii(bytes, i);
            else
            {
                if (esc > 0)
                {
                    put('\\');
                    put(cast(ubyte) esc);
                }
                else
                    unicodeEscape(b);
                ++i;
            }
            run = i;
        }
        put(bytes[run .. $]);
    }

    private size_t escapeNonAscii(scope const(ubyte)[] bytes, size_t i)
    {
        import std.utf : decode;

        size_t next = i;
        dchar c;
        try
            c = decode(cast(const(char)[]) bytes, next);
        catch (Exception)
        {
            unicodeEscape(0xFFFD);
            return i + 1;
        }
        if (c >= 0x10000)
        {
            immutable v = c - 0x10000;
            unicodeEscape(0xD800 + (v >> 10));
            unicodeEscape(0xDC00 + (v & 0x3FF));
        }
        else
            unicodeEscape(c);
        return next;
    }

    private void unicodeEscape(uint c)
    {
        immutable ubyte[6] escape = [
            '\\', 'u', _hex[(c >> 12) & 0xF], _hex[(c >> 8) & 0xF], _hex[(c >> 4) & 0xF], _hex[c & 0xF]
        ];
        put(escape[]);
    }

    override JsonGenerator writeNumber(int v)
    {
        return writeNumber(cast(long) v);
    }

    override JsonGenerator writeNumber(long v)
    {
        verifyValueWrite("write a number");
        char[20] digits;
        const text = digits[0 .. NumberOutput.writeLong(v, digits)];
        if (_numbersAsStrings)
            quoted(text);
        else
            put(text);
        return this;
    }

    override JsonGenerator writeNumber(double v)
    {
        char[javaNumberCapacity] text;
        const rendered = text[0 .. formatJavaDouble(v, text)];
        if (_numbersAsStrings || (_nanAsStrings && NumberOutput.notFinite(v)))
            return writeString(rendered.idup);
        verifyValueWrite("write a number");
        put(rendered);
        return this;
    }

    override JsonGenerator writeNumber(float v)
    {
        char[javaNumberCapacity] text;
        const rendered = text[0 .. formatJavaFloat(v, text)];
        if (_numbersAsStrings || (_nanAsStrings && NumberOutput.notFinite(v)))
            return writeString(rendered.idup);
        verifyValueWrite("write a number");
        put(rendered);
        return this;
    }

    override JsonGenerator writeNumber(string encodedValue)
    {
        if (encodedValue is null)
            return writeNull();
        verifyValueWrite("write a number");
        if (_numbersAsStrings)
            quoted(encodedValue);
        else
            put(encodedValue);
        return this;
    }

    override JsonGenerator writeBoolean(bool state)
    {
        verifyValueWrite("write a boolean value");
        put(state ? "true" : "false");
        return this;
    }

    override JsonGenerator writeNull()
    {
        verifyValueWrite("write a null");
        put("null");
        return this;
    }

    override JsonGenerator writeRaw(string text)
    {
        put(text);
        return this;
    }

    override JsonGenerator writeRaw(char c)
    {
        put(cast(ubyte) c);
        return this;
    }

    override JsonGenerator writeRawValue(string text)
    {
        verifyValueWrite("write a raw (unencoded) value");
        put(text);
        return this;
    }

    override void flush()
    {
        flushBuffer();
    }

    override void close()
    {
        if (_closed)
            return;
        if (isEnabled(StreamWriteFeature.AUTO_CLOSE_CONTENT))
        {
            for (;;)
            {
                if (_streamWriteContext.inArray())
                    writeEndArray();
                else if (_streamWriteContext.inObject())
                    writeEndObject();
                else
                    break;
            }
        }
        flushBuffer();
        _closed = true;
    }

    override bool isClosed()
    {
        return _closed;
    }
}

/// Extension of `TokenStreamContext`, which implements core methods needed, and also exposes more complete API to parser implementation classes.
final class JsonReadContext : TokenStreamContext
{
    private JsonReadContext _child;
    private int _depth;
    private size_t _startOffset;

    private this(int type, JsonReadContext parent, int depth, size_t startOffset) pure nothrow @nogc
    {
        _type = type;
        _parent = parent;
        _depth = depth;
        _index = -1;
        _startOffset = startOffset;
    }

    /// The root context of a new parser.
    static JsonReadContext createRootContext() pure nothrow
    {
        return new JsonReadContext(TYPE_ROOT, null, 0, 0);
    }

    private JsonReadContext child(int type, size_t offset) pure nothrow
    {
        if (_child is null)
            _child = new JsonReadContext(type, this, _depth + 1, offset);
        else
        {
            _child._type = type;
            _child._index = -1;
            _child._currentName = null;
            _child._currentValue = null;
            _child._startOffset = offset;
        }
        return _child;
    }

    /// Enter an Array.
    JsonReadContext createChildArrayContext(size_t offset) pure nothrow
    {
        return child(TYPE_ARRAY, offset);
    }

    /// Enter an Object.
    JsonReadContext createChildObjectContext(size_t offset) pure nothrow
    {
        return child(TYPE_OBJECT, offset);
    }

    /// The parent context.
    override JsonReadContext getParent() pure nothrow @nogc
    {
        return cast(JsonReadContext) _parent;
    }

    /// Nesting depth: 0 for the root.
    int getNestingDepth() const pure nothrow @nogc
    {
        return _depth;
    }

    /// Whether the next entry must be preceded by a comma.
    bool expectComma() pure nothrow @nogc
    {
        return ++_index > 0 && _type != TYPE_ROOT;
    }

    /// Record the current property name.
    void setCurrentName(string name) pure nothrow @nogc
    {
        _currentName = name;
    }
}

/**
 * This is a concrete implementation of `JsonParser`, which is based on a UTF-8
 * encoded byte buffer holding the complete document.
 */
class UTF8StreamJsonParser : JsonParser
{
    alias getValueAsInt = JsonParser.getValueAsInt;
    alias getValueAsLong = JsonParser.getValueAsLong;
    alias getValueAsDouble = JsonParser.getValueAsDouble;
    alias getValueAsBoolean = JsonParser.getValueAsBoolean;
    private ObjectReadContext _objectReadContext;
    private JsonFactory _factory;
    private StreamReadConstraints _constraints;
    private const(ubyte)[] _input;
    private size_t _inputPtr;
    private JsonReadContext _streamReadContext;
    private JsonToken _currToken;
    private bool _closed;
    private bool _nameCopied;

    // The current token's span: string contents or number text.
    private JsonTextToken _text;
    private JsonNumberToken _number;
    private size_t _tokenStart;
    private string _textCache;
    private bool _textCached;

    // Parsed numeric value of the current number token.
    private NumberType _numberType;
    private long _numberLong;
    private double _numberDouble;
    private bool _numberParsed;

    /// A parser over `content`, which it borrows until it is closed.
    this(ObjectReadContext readCtxt, JsonFactory factory, const(ubyte)[] content)
    {
        _objectReadContext = readCtxt;
        _factory = factory;
        _constraints = factory.streamReadConstraints();
        _input = content;
        _streamReadContext = JsonReadContext.createRootContext();
        // A UTF-8 byte order mark is skipped, as Jackson's bootstrapper does.
        if (content.length >= 3 && content[0] == 0xEF && content[1] == 0xBB && content[2] == 0xBF)
            _inputPtr = 3;
    }

    override bool isEnabled(StreamReadFeature f)
    {
        return _factory.isEnabled(f);
    }

    override ObjectReadContext objectReadContext()
    {
        return _objectReadContext;
    }

    override StreamReadConstraints streamReadConstraints()
    {
        return _constraints;
    }

    override TokenStreamContext streamReadContext()
    {
        return _streamReadContext;
    }

    override JsonToken currentToken()
    {
        return _currToken;
    }

    override string currentName()
    {
        // For START_OBJECT and START_ARRAY the name belongs to the enclosing context, as Jackson reports it.
        if (_currToken == JsonToken.START_OBJECT || _currToken == JsonToken.START_ARRAY)
        {
            auto parent = _streamReadContext.getParent();
            return parent is null ? null : parent.currentName();
        }
        return _streamReadContext.currentName();
    }

    override void close()
    {
        _closed = true;
        if (isEnabled(StreamReadFeature.CLEAR_CURRENT_TOKEN_ON_CLOSE))
            _currToken = JsonToken.NOT_AVAILABLE;
    }

    override bool isClosed()
    {
        return _closed;
    }

    private void skipWhitespace()
    {
        while (_inputPtr < _input.length)
        {
            immutable c = _input[_inputPtr];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r')
                return;
            ++_inputPtr;
        }
    }

    override JsonToken nextToken()
    {
        if (_closed)
            return JsonToken.NOT_AVAILABLE;
        _textCached = false;
        _numberParsed = false;
        if (_currToken == JsonToken.PROPERTY_NAME)
            return _currToken = readValue(_input[_inputPtr]);
        skipWhitespace();
        if (_inputPtr == _input.length)
            return _currToken = endOfInput();
        ubyte c = _input[_inputPtr];
        if (c == ']' || c == '}')
        {
            closeScope(c);
            return _currToken;
        }
        if (_streamReadContext.expectComma())
            c = afterComma(c);
        if (_streamReadContext.inObject())
            return _currToken = readName(c);
        return _currToken = readValue(c);
    }

    // At the end of input: fine at the root, an error inside an Array or Object.
    private JsonToken endOfInput()
    {
        if (!_streamReadContext.inRoot())
            throw new UnexpectedEndOfInputException(this, JsonToken.NOT_AVAILABLE,
                    "Unexpected end-of-input: expected close marker for " ~ _streamReadContext.typeDesc()
                    ~ " (start marker at " ~ locationAt(_streamReadContext._startOffset)
                        .toString() ~ ")", currentLocation());
        close();
        return JsonToken.NOT_AVAILABLE;
    }

    // Consume the comma that must separate entries and return the first byte of the next one.
    private ubyte afterComma(ubyte c)
    {
        if (c != ',')
            throw unexpected(c, "was expecting comma to separate " ~ _streamReadContext.typeDesc() ~ " entries");
        ++_inputPtr;
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn("a value");
        c = _input[_inputPtr];
        if (c == ']' || c == '}')
            throw unexpected(c, "expected a value");
        return c;
    }

    private JsonToken readName(ubyte c)
    {
        if (c != '"')
            throw unexpected(c, "was expecting double-quote to start property name");
        _tokenStart = _inputPtr;
        auto scanner = JsonScanner(_input, JsonDecodeOptions.init);
        scanner.offset = _inputPtr;
        JsonTextToken token;
        const error = scanner.text(token);
        if (error.code)
            throw stringError(scanner.offset, error.message);
        if (token.length > _constraints.maxNameLength)
        {
            immutable limit = decimal(_constraints.maxNameLength);
            throw new StreamConstraintsException("Name length (" ~ decimal(
                    cast(long) token.length) ~ ") exceeds the maximum allowed (" ~ limit ~ ")");
        }
        _inputPtr = scanner.offset;
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn("an Object entry");
        if (_input[_inputPtr] != ':')
            throw unexpected(_input[_inputPtr], "was expecting a colon to separate property name and value");
        ++_inputPtr;
        skipWhitespace();
        if (_inputPtr == _input.length)
            throw eofIn("an Object value");
        _streamReadContext.setCurrentName(decode(token));
        return JsonToken.PROPERTY_NAME;
    }

    private JsonToken readValue(ubyte c)
    {
        _tokenStart = _inputPtr;
        switch (c)
        {
        case '{':
            ++_inputPtr;
            enter(_streamReadContext.createChildObjectContext(_tokenStart));
            return JsonToken.START_OBJECT;
        case '[':
            ++_inputPtr;
            enter(_streamReadContext.createChildArrayContext(_tokenStart));
            return JsonToken.START_ARRAY;
        case '"':
            return readString();
        case 't':
            return literal("true", JsonToken.VALUE_TRUE);
        case 'f':
            return literal("false", JsonToken.VALUE_FALSE);
        case 'n':
            return literal("null", JsonToken.VALUE_NULL);
        default:
            if (c == '-' || (c >= '0' && c <= '9'))
                return readNumber();
            throw unexpected(c,
                    "expected a valid value (JSON String, Number, Array, Object or token 'null', 'true' or 'false')");
        }
    }

    private JsonToken readString()
    {
        auto scanner = JsonScanner(_input, JsonDecodeOptions.init);
        scanner.offset = _inputPtr;
        const error = scanner.textValue(_text);
        if (error.code)
            throw stringError(scanner.offset, error.message);
        if (_text.length > _constraints.maxStringLength)
            throw new StreamConstraintsException("String value length (" ~ decimal(cast(
                    long) _text.length) ~ ") exceeds the maximum allowed (" ~ decimal(_constraints.maxStringLength)
                    ~ ")");
        _inputPtr = scanner.offset;
        return JsonToken.VALUE_STRING;
    }

    private void enter(JsonReadContext child)
    {
        if (child.getNestingDepth() > _constraints.maxNestingDepth)
            throw new StreamConstraintsException("Document nesting depth (" ~ decimal(
                    child.getNestingDepth()) ~ ") exceeds the maximum allowed (" ~ decimal(
                    _constraints.maxNestingDepth) ~ ", from `StreamReadConstraints.getMaxNestingDepth()`)",
                    currentLocation());
        _streamReadContext = child;
    }

    private void closeScope(ubyte c)
    {
        immutable array = c == ']';
        if (array ? !_streamReadContext.inArray() : !_streamReadContext.inObject())
            throw unexpected(c, "Unexpected close marker '" ~ cast(char) c ~ "': expected '" ~ (
                    _streamReadContext.inArray() ? "]" : _streamReadContext.inObject() ? "}" : "a value")
                    ~ "' (for " ~ _streamReadContext.typeDesc() ~ " starting at " ~ locationAt(
                        _streamReadContext._startOffset).toString() ~ ")", true);
        _tokenStart = _inputPtr;
        ++_inputPtr;
        _streamReadContext = _streamReadContext.getParent();
        _currToken = array ? JsonToken.END_ARRAY : JsonToken.END_OBJECT;
    }

    private JsonToken literal(string word, JsonToken token)
    {
        immutable end = _inputPtr + word.length;
        if (end > _input.length || cast(const(char)[]) _input[_inputPtr .. end] != word)
            throw unrecognized();
        _inputPtr = end;
        if (_inputPtr < _input.length && !separator(_input[_inputPtr]))
            throw unrecognized();
        return token;
    }

    private static bool separator(ubyte c) pure nothrow @nogc
    {
        return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == ',' || c == ']' || c == '}' || c == ':';
    }

    private JsonToken readNumber()
    {
        auto scanner = JsonScanner(_input, JsonDecodeOptions.init);
        scanner.offset = _inputPtr;
        const error = scanner.number(_number);
        if (error.code)
            throw readError("Invalid numeric value: " ~ (leadingZero(_inputPtr)
                    ? "Leading zeroes not allowed" : error.message));
        _inputPtr = scanner.offset;
        immutable length = _number.end - _number.start;
        if (length > _constraints.maxNumberLength)
            throw new StreamConstraintsException("Number value length (" ~ decimal(cast(
                    long) length) ~ ") exceeds the maximum allowed (" ~ decimal(_constraints.maxNumberLength) ~ ")",
                    currentLocation());
        if (_inputPtr < _input.length && !separator(_input[_inputPtr]))
        {
            if (length == 1 && leadingZero(_number.start))
                throw readError("Invalid numeric value: Leading zeroes not allowed");
            throw unexpected(_input[_inputPtr], "Expected space separating root-level values", true);
        }
        return _number.fractional ? JsonToken.VALUE_NUMBER_FLOAT : JsonToken.VALUE_NUMBER_INT;
    }

    // Whether a '0' at `offset` is followed by another digit.
    private bool leadingZero(size_t offset) const pure nothrow @nogc
    {
        return offset + 1 < _input.length && _input[offset] == '0' && _input[offset + 1] >= '0'
            && _input[offset + 1] <= '9';
    }

    private string decode(JsonTextToken token)
    {
        if (token.length == token.end - token.start)
            return (cast(const(char)[]) _input[token.start .. token.end]).idup;
        auto output = new char[token.length];
        if (!copyJsonText(_input, token, cast(ubyte[]) output))
            throw readError("Invalid JSON string");
        return output.idup;
    }

    override string getString()
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_STRING:
            if (!_textCached)
            {
                _textCache = decode(_text);
                _textCached = true;
            }
            return _textCache;
        case JsonToken.PROPERTY_NAME:
            return _streamReadContext.currentName();
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            return (cast(const(char)[]) _input[_number.start .. _number.end]).idup;
        case JsonToken.NOT_AVAILABLE:
            return null;
        default:
            import flint.jackson.core : asString;

            return _currToken.asString();
        }
    }

    override JsonParser skipChildren()
    {
        if (_currToken != JsonToken.START_OBJECT && _currToken != JsonToken.START_ARRAY)
            return this;
        int open = 1;
        for (;;)
        {
            const t = nextToken();
            if (t == JsonToken.NOT_AVAILABLE)
                return this;
            if (t == JsonToken.START_OBJECT || t == JsonToken.START_ARRAY)
                ++open;
            else if ((t == JsonToken.END_OBJECT || t == JsonToken.END_ARRAY) && --open == 0)
                return this;
        }
    }

    private void parseNumber()
    {
        if (_numberParsed)
            return;
        if (_currToken != JsonToken.VALUE_NUMBER_INT && _currToken != JsonToken.VALUE_NUMBER_FLOAT)
            throw coercionError("Current token (" ~ tokenName(
                    _currToken) ~ ") not numeric, cannot use numeric value accessors", _currToken);
        auto text = _input[_number.start .. _number.end];
        if (_currToken == JsonToken.VALUE_NUMBER_FLOAT)
        {
            if (!parseJsonDecimal(text, _numberDouble))
                _numberDouble = text[0] == '-' ? -double.infinity : double.infinity;
            _numberType = NumberType.DOUBLE;
        }
        else
        {
            immutable negative = text[0] == '-';
            ulong magnitude;
            bool overflow;
            foreach (d; text[negative ? 1 : 0 .. $])
            {
                if (magnitude > (ulong.max - (d - '0')) / 10)
                {
                    overflow = true;
                    break;
                }
                magnitude = magnitude * 10 + (d - '0');
            }
            immutable limit = negative ? cast(ulong) long.max + 1 : cast(ulong) long.max;
            if (overflow || magnitude > limit)
            {
                _numberType = NumberType.BIG_INTEGER;
                parseJsonDecimal(text, _numberDouble);
            }
            else
            {
                _numberLong = negative ? -cast(long)(magnitude - 1) - 1 : cast(long) magnitude;
                _numberDouble = cast(double) _numberLong;
                _numberType = _numberLong >= int.min && _numberLong <= int.max ? NumberType.INT : NumberType.LONG;
            }
        }
        _numberParsed = true;
    }

    override NumberType getNumberType()
    {
        parseNumber();
        return _numberType;
    }

    override int getIntValue()
    {
        parseNumber();
        if (_numberType == NumberType.INT)
            return cast(int) _numberLong;
        if (_numberType == NumberType.DOUBLE && _numberDouble >= int.min && _numberDouble <= int.max)
            return cast(int) _numberDouble;
        throw coercionError("Numeric value (" ~ longIntegerDesc(
                getString()) ~ ") out of range of `int` (-2147483648 - 2147483647)", _currToken);
    }

    override long getLongValue()
    {
        parseNumber();
        if (_numberType == NumberType.INT || _numberType == NumberType.LONG)
            return _numberLong;
        if (_numberType == NumberType.DOUBLE && _numberDouble >= -0x1p63 && _numberDouble < 0x1p63)
            return cast(long) _numberDouble;
        throw coercionError("Numeric value (" ~ longIntegerDesc(getString())
                ~ ") out of range of `long` (-9223372036854775808 - 9223372036854775807)", _currToken);
    }

    // ParserMinimalBase._longIntegerDesc: very long numbers are described by their digit count.
    private static string longIntegerDesc(string raw) pure nothrow
    {
        if (raw.length < 1000)
            return raw;
        immutable digits = raw[0] == '-' ? raw[1 .. $].length : raw.length;
        return "[Integer with " ~ decimal(cast(long) digits) ~ " digits]";
    }

    override double getDoubleValue()
    {
        parseNumber();
        return _numberDouble;
    }

    override float getFloatValue()
    {
        parseNumber();
        if (_currToken == JsonToken.VALUE_NUMBER_FLOAT)
        {
            float[1] value;
            if (parseJsonDecimal(_input[_number.start .. _number.end], value[0]))
                return value[0];
        }
        return cast(float) _numberDouble;
    }

    override int getValueAsInt(int def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            parseNumber();
            if (_numberType == NumberType.INT || _numberType == NumberType.LONG)
                return cast(int) _numberLong;
            return cast(int) _numberDouble;
        case JsonToken.VALUE_TRUE:
            return 1;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return 0;
        case JsonToken.VALUE_STRING:
            return cast(int) parseAsLong(getString(), def);
        default:
            return def;
        }
    }

    override long getValueAsLong(long def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            parseNumber();
            if (_numberType == NumberType.INT || _numberType == NumberType.LONG)
                return _numberLong;
            return cast(long) _numberDouble;
        case JsonToken.VALUE_TRUE:
            return 1;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return 0;
        case JsonToken.VALUE_STRING:
            return parseAsLong(getString(), def);
        default:
            return def;
        }
    }

    override double getValueAsDouble(double def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
        case JsonToken.VALUE_NUMBER_FLOAT:
            return getDoubleValue();
        case JsonToken.VALUE_TRUE:
            return 1.0;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return 0.0;
        case JsonToken.VALUE_STRING:
            double[1] value;
            auto text = cast(const(ubyte)[]) getString();
            return text.length && parseJsonDecimal(text, value[0]) ? value[0] : def;
        default:
            return def;
        }
    }

    override bool getValueAsBoolean(bool def)
    {
        switch (_currToken)
        {
        case JsonToken.VALUE_NUMBER_INT:
            return getIntValue() != 0;
        case JsonToken.VALUE_TRUE:
            return true;
        case JsonToken.VALUE_FALSE:
        case JsonToken.VALUE_NULL:
            return false;
        case JsonToken.VALUE_STRING:
            import std.string : strip;

            const text = getString().strip();
            if (text == "true")
                return true;
            if (text == "false" || text == "null")
                return false;
            return def;
        default:
            return def;
        }
    }

    // NumberInput.parseAsLong: trimmed decimal digits, else the default.
    private static long parseAsLong(string text, long def) pure nothrow
    {
        import std.string : strip;

        const s = text.strip();
        if (s.length == 0)
            return def;
        size_t i = s[0] == '-' || s[0] == '+' ? 1 : 0;
        if (i == s.length)
            return def;
        long value;
        foreach (c; s[i .. $])
        {
            if (c < '0' || c > '9')
                return def;
            value = value * 10 + (c - '0');
        }
        return s[0] == '-' ? -value : value;
    }

    override TokenStreamLocation currentTokenLocation()
    {
        return locationAt(_tokenStart);
    }

    override TokenStreamLocation currentLocation()
    {
        return locationAt(_inputPtr);
    }

    private TokenStreamLocation locationAt(size_t offset)
    {
        int line = 1;
        size_t lineStart;
        foreach (i, b; _input[0 .. offset < _input.length ? offset : _input.length])
        {
            if (b == '\n')
            {
                ++line;
                lineStart = i + 1;
            }
        }
        return new TokenStreamLocation(cast(long) offset, -1, line, cast(int)(offset - lineStart + 1));
    }

    private JacksonException unexpected(ubyte c, string comment, bool whole = false)
    {
        import std.conv : to;

        // Concatenation, not std.format: format alone instantiated about 4,000 templates in this module.
        const code = "code " ~ (cast(uint) c).to!string;
        const printable = c >= 0x20 && c < 0x7F;
        auto description = printable ? "'" ~ cast(char) c ~ "' (" ~ code ~ ")" : "(CTRL-CHAR, " ~ code ~ ")";
        if (whole)
            return readError(comment);
        return readError("Unexpected character (" ~ description ~ "): " ~ comment);
    }

    private JacksonException unrecognized()
    {
        size_t end = _inputPtr;
        while (end < _input.length && end - _inputPtr < 256 && !separator(_input[end]) && _input[end] != '"')
            ++end;
        return readError("Unrecognized token '" ~ (cast(const(char)[]) _input[_inputPtr .. end])
                .idup ~ "': was expecting (JSON String, Number, Array, Object or token 'null', 'true' or 'false')");
    }

    private JacksonException eofIn(string what)
    {
        return new UnexpectedEndOfInputException(this, JsonToken.NOT_AVAILABLE,
                "Unexpected end-of-input within/between " ~ what, currentLocation());
    }

    private JacksonException stringError(size_t offset, string message)
    {
        _inputPtr = offset;
        if (offset >= _input.length)
            return new UnexpectedEndOfInputException(this, JsonToken.VALUE_STRING,
                    "Unexpected end-of-input: was expecting closing quote for a string value", currentLocation());
        return readError("Illegal character in JSON string: " ~ message);
    }
}
