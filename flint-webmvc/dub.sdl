name "webmvc"
description "Flint Web MVC: the port of spring-webmvc (DUB flint:webmvc)"
license "Apache-2.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"
dependency "web" path="../web"
dependency "p1-interim" path="../p1-interim"
dependency "jakarta-servlet" path="../jakarta-servlet"
dependency "engine-aot" path="../../packages/engine-aot"

configuration "library" {
    targetType "library"
}
configuration "unittest" {
    targetType "library"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}
